---
import { profile } from '../data/profile';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top reveal">
      <div>
        <p class="footer-name">{profile.name}</p>
        <p class="footer-role">{profile.role}</p>
      </div>
      <ul class="footer-links">
        {profile.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <p class="footer-note reveal">
      이 사이트는 Astro로 직접 설계·제작했으며 GitHub Pages로 배포됩니다.
      <a href="https://github.com/lomong7807/resume" target="_blank" rel="noopener noreferrer">
        소스 보기
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--wash-warm);
    padding-block: clamp(2.5rem, 6vw, 3.25rem);
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-name {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .footer-role {
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
    padding-top: 0.15rem;
  }

  .footer-links a {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-muted);
    transition: color 150ms ease;
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .footer-note {
    margin-top: 2rem;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    .footer-top {
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links a {
      transition: none;
    }
  }
</style>
