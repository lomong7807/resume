---
import { profile } from '../data/profile';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top reveal">
      <div>
        <p class="footer-name">{profile.name}</p>
        <p class="footer-role">{profile.role}</p>
      </div>
      <ul class="footer-links">
        {profile.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
          </li>
        ))}
        <li>
          <button class="btn--print" type="button" onclick="window.print()">PDF로 저장</button>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* 다크 클로징 밴드 — 페이지를 닫는 프레임 */
  .site-footer {
    background: var(--ink);
    color: #e8eaed;
    padding-block: clamp(2rem, 4vw, 2.5rem);
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-name {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    color: #ffffff;
  }

  .footer-role {
    font-size: 0.85rem;
    color: #9aa1a9;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
    padding-top: 0.15rem;
  }

  .footer-links a {
    font-size: 0.88rem;
    font-weight: 600;
    color: #9db8f7;
    transition: color 150ms ease;
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  /* 이력서 제출용 인쇄 버튼 — 눈에 띄지 않게 링크와 같은 톤 */
  .btn--print {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: #9aa1a9;
    background: none;
    border: 1px solid #3a3e44;
    border-radius: 4px;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .btn--print:hover {
    color: #ffffff;
    border-color: #9aa1a9;
  }

  /* JS가 없으면 동작하지 않으므로 숨긴다 */
  html:not(.js) .btn--print {
    display: none;
  }

  @media (max-width: 760px) {
    .footer-top {
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links a {
      transition: none;
    }
  }

  @media print {
    .site-footer {
      background: #fff;
      color: var(--ink);
    }
  }
</style>
