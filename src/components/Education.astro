---
import Section from './Section.astro';
import { education, etc } from '../data/education';
import type { TimelineItem } from '../data/types';

const groups: { label: string; items: TimelineItem[] }[] = [
  { label: '학력', items: education },
  { label: '활동·기타', items: etc },
];

/** 'YYYY-MM' 데이터를 'YYYY.MM - YYYY.MM' 표기로 변환한다. */
const period = ({ start, end }: TimelineItem) =>
  `${start.replace('-', '.')} - ${end.replace('-', '.')}`;
---

<Section id="education" title="학력 및 활동" tint>
  {groups.map((group) => (
    <div class="tl-group">
      <h3 class="tl-group-title reveal">{group.label}</h3>
      <ul>
        {group.items.map((item) => (
          <li class="tl-row reveal">
            <span class="meta">{period(item)}</span>
            <div>
              <h4 class="tl-title">{item.title}</h4>
              <p class="tl-detail">{item.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</Section>

<style>
  .tl-group + .tl-group {
    margin-top: 2.25rem;
  }

  .tl-group-title {
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .tl-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 0.95rem;
  }

  .tl-row:not(:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .tl-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .tl-detail {
    margin-top: 0.15rem;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    .tl-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
