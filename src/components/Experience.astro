---
import Section from './Section.astro';
import { experiences } from '../data/experience';
import { inline } from '../lib/inline';

/** YYYY-MM → YYYY.MM, end가 null이면 "현재" */
const ym = (value: string) => value.replace('-', '.');
const period = (start: string, end: string | null) => `${ym(start)} - ${end ? ym(end) : '현재'}`;

// 가장 이른 입사월부터 빌드 시점까지의 총 경력 개월 수
const firstStart = experiences.reduce((min, e) => (e.start < min ? e.start : min), experiences[0].start);
const [startYear, startMonth] = firstStart.split('-').map(Number);
const now = new Date();
const months = (now.getFullYear() - startYear) * 12 + (now.getMonth() + 1 - startMonth);
const years = Math.floor(months / 12);
const restMonths = months % 12;
const totalLabel = `총 ${[years > 0 && `${years}년`, restMonths > 0 && `${restMonths}개월`]
  .filter(Boolean)
  .join(' ')}`;
---

<Section id="experience" title="경력">
  <span class="meta" slot="head-meta">{totalLabel}</span>

  <ol>
    {experiences.map((exp) => (
      <li class="exp reveal">
        <div class="exp-side">
          <span class="meta">{period(exp.start, exp.end)}</span>
          <h3 class="exp-company">{exp.company}</h3>
          <p class="exp-role">{exp.role}</p>
          <p class="exp-team">{exp.team}</p>
        </div>

        <div class="exp-body">
          <p class="exp-summary">{exp.summary}</p>
          <ul class="bullets">
            {exp.highlights.map((highlight) => (
              <li set:html={inline(highlight)} />
            ))}
          </ul>
          <p class="tech-line">{exp.tech.join(', ')}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  .exp {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
    padding-block: 2rem;
  }

  .exp:first-child {
    padding-top: 0;
  }

  .exp:not(:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .exp-company {
    margin-top: 0.35rem;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .exp-role {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .exp-team {
    margin-top: 0.1rem;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .exp-summary {
    margin-bottom: 0.85rem;
    font-weight: 600;
  }

  .exp-body .tech-line {
    margin-top: 1rem;
  }

  @media (max-width: 760px) {
    .exp {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-block: 1.75rem;
    }
  }
</style>
