---
import Section from './Section.astro';
import { experiences } from '../data/experience';
import { inline } from '../lib/inline';

/** YYYY-MM → YYYY.MM, end가 null이면 "현재" */
const ym = (value: string) => value.replace('-', '.');
const period = (start: string, end: string | null) => `${ym(start)} — ${end ? ym(end) : '현재'}`;

// 가장 이른 입사월부터 빌드 시점까지의 총 경력 개월 수
const firstStart = experiences.reduce((min, e) => (e.start < min ? e.start : min), experiences[0].start);
const [startYear, startMonth] = firstStart.split('-').map(Number);
const now = new Date();
const months = (now.getFullYear() - startYear) * 12 + (now.getMonth() + 1 - startMonth);
const years = Math.floor(months / 12);
const restMonths = months % 12;
const totalLabel = `총 ${[years > 0 && `${years}년`, restMonths > 0 && `${restMonths}개월`]
  .filter(Boolean)
  .join(' ')}`;
---

<Section id="experience" overline="EXPERIENCE" title="경력">
  <p class="exp-total reveal">
    <span class="chip chip--accent">{totalLabel}</span>
  </p>

  <ol class="timeline">
    {experiences.map((exp, i) => (
      <li
        class:list={['exp', 'reveal', { 'exp--current': exp.end === null }]}
        style={`--reveal-delay: ${i * 80}ms`}
      >
        <div class="exp-side">
          <span class="meta">{period(exp.start, exp.end)}</span>
          <h3 class="exp-company">{exp.company}</h3>
          <p class="exp-role">{exp.role}</p>
          <p class="exp-team">{exp.team}</p>
        </div>

        <div class="exp-body">
          <p class="exp-summary">{exp.summary}</p>
          <ul class="bullets">
            {exp.highlights.map((highlight) => (
              <li set:html={inline(highlight)} />
            ))}
          </ul>
          <ul class="exp-tech">
            {exp.tech.map((tech) => (
              <li class="chip">{tech}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  /* 섹션 헤드 바로 아래에 붙여 제목의 일부처럼 읽히게 */
  .exp-total {
    margin-top: -1.25rem;
    margin-bottom: 2rem;
  }

  .exp {
    position: relative;
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 2rem;
    padding-left: 1.75rem;
    padding-bottom: 3.25rem;
    border-left: 1px solid var(--line);
  }

  .exp:last-child {
    padding-bottom: 0;
  }

  /* 타임라인 도트 — 재직 중 항목만 accent */
  .exp::before {
    content: '';
    position: absolute;
    left: -4.5px;
    top: 0.5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
    box-shadow: 0 0 0 3px var(--bg);
  }

  .exp--current::before {
    background: var(--accent);
  }

  .exp-side {
    padding-top: 0.1rem;
  }

  .exp-company {
    margin-top: 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .exp-role {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .exp-team {
    margin-top: 0.1rem;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .exp-summary {
    margin-bottom: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  .exp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1.15rem;
  }

  @media (max-width: 760px) {
    .exp {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-left: 1.35rem;
      padding-bottom: 2.5rem;
    }
  }
</style>
