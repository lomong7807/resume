---
import Section from './Section.astro';
import { companyProjects, sideProjects } from '../data/projects';

/** YYYY-MM → YYYY.MM, end가 null이면 "진행 중", 시작·종료가 같은 달이면 한 번만 표기 */
const ym = (value: string) => value.replace('-', '.');
const period = (start: string, end: string | null) =>
  end === start ? ym(start) : `${ym(start)} - ${end ? ym(end) : '진행 중'}`;
---

<Section id="projects" title="프로젝트">
  <ul>
    {companyProjects.map((project) => (
      <li class="proj reveal">
        <div class="proj-side">
          <span class="meta">{period(project.start, project.end)}</span>
          <p class="proj-org">{project.org}</p>
        </div>

        <div class="proj-body">
          <h3 class="proj-name">{project.name}</h3>
          <p class="proj-summary">{project.summary}</p>

          <ul class="bullets">
            {project.work.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          {project.outcome && (
            <ul class="proj-outcome">
              {project.outcome.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}

          <ul class="tech-list">
            {project.tech.map((tech) => (
              <li class="tech-tag">{tech}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ul>

  {sideProjects.length > 0 && (
    <div class="side">
      <h3 class="side-title reveal">사이드 프로젝트</h3>
      <ul class="side-grid">
        {sideProjects.map((project) => (
          <li class="side-item reveal">
            <span class="meta">{project.period}</span>
            <h4 class="side-name">{project.name}</h4>
            <p class="side-body">{project.description}</p>
            <p class="side-role">{project.role}</p>
            <ul class="tech-list">
              {project.tech.map((tech) => (
                <li class="tech-tag">{tech}</li>
              ))}
            </ul>
            <a class="side-link" href={project.repo} target="_blank" rel="noopener noreferrer">
              GitHub에서 보기
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>

<style>
  /* 경력 섹션과 같은 2컬럼: 왼쪽 기간·소속, 오른쪽 내용 */
  .proj {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
    padding-block: 1.75rem;
  }

  .proj:first-child {
    padding-top: 0;
  }

  .proj:not(:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .proj-org {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .proj-name {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin-bottom: 0.6rem;
  }

  .proj-summary {
    color: var(--ink-soft);
    max-width: 42rem;
    margin-bottom: 1rem;
  }

  .proj-outcome {
    margin-top: 0.9rem;
  }

  .proj-outcome li {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.3rem;
    font-variant-numeric: tabular-nums;
  }

  .proj .tech-list {
    margin-top: 1.1rem;
  }

  /* ── 사이드 프로젝트 ── */
  .side {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .side-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 1.4rem;
  }

  .side-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem 2.5rem;
  }

  .side-name {
    margin-top: 0.2rem;
    font-size: 1rem;
    font-weight: 700;
  }

  .side-body {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .side-role {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .side-item .tech-list {
    margin-top: 0.6rem;
  }

  .side-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .proj {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding-block: 1.4rem;
    }

    .side-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
