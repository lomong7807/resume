---
import Section from './Section.astro';
import { companyProjects, sideProjects } from '../data/projects';

/** YYYY-MM → YYYY.MM, end가 null이면 "진행 중" */
const ym = (value: string) => value.replace('-', '.');
const period = (start: string, end: string | null) => `${ym(start)} - ${end ? ym(end) : '진행 중'}`;
---

<Section id="projects" title="프로젝트">
  <ul>
    {companyProjects.map((project) => (
      <li class="proj reveal">
        <header class="proj-head">
          <h3 class="proj-name">{project.name}</h3>
          <span class="meta">{project.org} · {period(project.start, project.end)}</span>
        </header>

        <p class="proj-summary">{project.summary}</p>

        <ul class="bullets">
          {project.work.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        {project.outcome && (
          <ul class="proj-outcome">
            {project.outcome.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}

        <p class="tech-line">{project.tech.join(', ')}</p>
      </li>
    ))}
  </ul>

  {sideProjects.length > 0 && (
    <div class="side">
      <h3 class="side-title reveal">사이드 프로젝트</h3>
      <ul class="side-grid">
        {sideProjects.map((project) => (
          <li class="side-item reveal">
            <header class="side-head">
              <h4 class="side-name">{project.name}</h4>
              <span class="meta">{project.period}</span>
            </header>
            <p class="side-body">{project.description}</p>
            <p class="side-role">{project.role}</p>
            <p class="tech-line">{project.tech.join(', ')}</p>
            <a class="side-link" href={project.repo} target="_blank" rel="noopener noreferrer">
              GitHub에서 보기
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>

<style>
  .proj {
    padding-block: 2.25rem;
  }

  .proj:first-child {
    padding-top: 0;
  }

  .proj:not(:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .proj-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }

  .proj-name {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .proj-summary {
    color: var(--ink-soft);
    max-width: 42rem;
    margin-bottom: 1rem;
  }

  .proj-outcome {
    margin-top: 0.9rem;
  }

  .proj-outcome li {
    font-weight: 600;
    color: var(--accent-deep);
    margin-bottom: 0.3rem;
    font-variant-numeric: tabular-nums;
  }

  .proj .tech-line {
    margin-top: 1.1rem;
  }

  /* ── 사이드 프로젝트 ── */
  .side {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .side-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 1.4rem;
  }

  .side-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem 2.5rem;
  }

  .side-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .side-name {
    font-size: 1rem;
    font-weight: 700;
  }

  .side-body {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .side-role {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .side-item .tech-line {
    margin-top: 0.6rem;
  }

  .side-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .proj-head {
      flex-direction: column;
      gap: 0.3rem;
    }

    .side-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
