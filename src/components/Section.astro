---
interface Props {
  id: string;
  title: string;
  tint?: boolean;
}

const { id, title, tint = false } = Astro.props;
---

<section class:list={['section', { 'section--tint': tint }]} id={id}>
  <div class="container">
    <header class="section-head reveal">
      <h2 class="section-title">{title}</h2>
      <slot name="head-meta" />
    </header>
    <slot />
  </div>
</section>

<style>
  /* 제목 왼쪽의 코발트 바로 대메뉴 시작점을 표시 */
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title::before {
    content: '';
    width: 4px;
    height: 1.15em;
    border-radius: 2px;
    background: var(--accent);
    flex-shrink: 0;
  }
</style>
