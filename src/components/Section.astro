---
interface Props {
  id: string;
  title: string;
  tint?: boolean;
}

const { id, title, tint = false } = Astro.props;
---

<section class:list={['section', { 'section--tint': tint }]} id={id}>
  <div class="container">
    <header class="section-head reveal">
      <h2 class="section-title">{title}</h2>
      <slot name="head-meta" />
    </header>
    <slot />
  </div>
</section>
