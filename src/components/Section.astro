---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <header class="section-head reveal">
      <h2 class="section-title">{title}</h2>
      <slot name="head-meta" />
    </header>
    <slot />
  </div>
</section>
