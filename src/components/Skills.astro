---
import Section from './Section.astro';
import { skills } from '../data/skills';
---

<Section id="skills" title="기술 스택">
  <ul class="skill-list">
    {skills.map((category) => (
      <li class="skill-row reveal">
        <h3 class="skill-category">{category.name}</h3>
        <p class="skill-items">
          {category.items.map((item, i) => (
            <>
              <span class:list={[{ 'is-primary': item.primary }]}>{item.name}</span>{i < category.items.length - 1 && ', '}
            </>
          ))}
        </p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .skill-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.1rem;
  }

  .skill-row:first-child {
    padding-top: 0;
  }

  .skill-row:not(:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .skill-category {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .skill-items {
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .skill-items .is-primary {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding-block: 0.95rem;
    }
  }
</style>
