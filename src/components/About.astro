---
import Section from './Section.astro';
import { about } from '../data/about';
import { profile } from '../data/profile';

const blog = profile.links.find((link) => link.label === 'Blog');
---

<Section id="about" title={about.headline}>
  <ul class="about-grid">
    {about.points.map((point) => (
      <li class="about-point reveal">
        <h3 class="about-title">{point.title}</h3>
        <p class="about-body">{point.body}</p>
      </li>
    ))}
  </ul>

  {blog && (
    <p class="about-blog reveal">
      <a href={blog.url} target="_blank" rel="noopener noreferrer">블로그에서 기록 보기</a>
    </p>
  )}
</Section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem 2rem;
  }

  .about-point {
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }

  .about-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .about-body {
    margin-top: 0.55rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .about-blog {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    font-size: 0.92rem;
  }

  .about-blog a {
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
