---
import Section from './Section.astro';
import { about } from '../data/about';
import { profile } from '../data/profile';

const blog = profile.links.find((link) => link.label === 'Blog');
---

<Section id="about" overline="ABOUT" title={about.headline}>
  <ul class="about-grid">
    {about.points.map((point, i) => (
      <li class="about-point reveal" style={`--reveal-delay: ${i * 80}ms`}>
        <span class="about-index">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="about-title">{point.title}</h3>
        <p class="about-body">{point.body}</p>
      </li>
    ))}
  </ul>

  {blog && (
    <p class="about-blog reveal" style="--reveal-delay: 240ms">
      <a href={blog.url} target="_blank" rel="noopener noreferrer">
        블로그에서 기록을 보실 수 있습니다 <span class="about-arrow" aria-hidden="true">→</span>
      </a>
    </p>
  )}
</Section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem 2rem;
  }

  .about-point {
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }

  .about-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .about-title {
    margin-top: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .about-body {
    margin-top: 0.55rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .about-blog {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    font-size: 0.92rem;
  }

  .about-blog a {
    color: var(--accent);
    font-weight: 500;
  }

  .about-arrow {
    display: inline-block;
    transition: transform 150ms var(--ease-out);
  }

  .about-blog a:hover .about-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-arrow {
      transition: none;
    }
  }
</style>
