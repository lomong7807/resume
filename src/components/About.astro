---
import Section from './Section.astro';
import { about } from '../data/about';
---

<Section id="about" title={about.title}>
  <div class="about-body reveal">
    {about.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
</Section>

<style>
  .about-body {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--ink-soft);
  }

  .about-body p + p {
    margin-top: 1.25rem;
  }
</style>
