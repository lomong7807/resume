---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Markdown 페이지(src/pages/*.md)용 레이아웃. frontmatter로 title/description/path를 받는다.
const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description} path={frontmatter.path}>
  <Nav />
  <main class="doc container">
    <slot />
  </main>
  <Footer />
</Base>

<style is:global>
  .doc {
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }

  .doc h1 {
    font-size: clamp(1.5rem, 3vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  /* 섹션 제목: 사이트의 섹션 제목과 같은 코발트 바 */
  .doc h2 {
    margin-top: 2.75rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .doc h2::before {
    content: '';
    width: 4px;
    height: 1.1em;
    border-radius: 2px;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* 프로젝트 제목: 헤어라인으로 항목 구분 */
  .doc h3 {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .doc h4 {
    margin-top: 1.2rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .doc p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
  }

  .doc h1 + p {
    margin-top: 0.75rem;
    color: var(--ink);
  }

  .doc strong {
    color: var(--ink);
    font-weight: 600;
  }

  .doc ul {
    margin-top: 0.4rem;
  }

  .doc li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.4rem;
    color: var(--ink-soft);
  }

  .doc li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.5rem;
    height: 2px;
    border-radius: 1px;
    background: var(--ink-muted);
  }

  .doc table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.75rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .doc th,
  .doc td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--line);
    overflow-wrap: anywhere;
  }

  .doc th {
    background: var(--bg-soft);
    font-weight: 600;
    white-space: nowrap;
  }

  .doc td:first-child {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .doc hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.25rem 0;
  }

  .doc code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85em;
    background: var(--bg-soft);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
  }

  .doc a {
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .doc td:first-child {
      white-space: normal;
    }
  }

  @media print {
    .doc h3 {
      break-inside: avoid;
    }

    .doc table,
    .doc tr {
      break-inside: avoid;
    }
  }
</style>
